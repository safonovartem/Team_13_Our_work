# Скопируйте в .env и задайте свои значения.
# Переменные читаются только из окружения; загрузка .env-файла не выполняется.

TSP_DATABASE_PATH=data/tank_safety.db
TSP_SECRET_KEY=replace-with-a-random-32-byte-secret
TSP_ACCESS_TOKEN_TTL_MINUTES=720
TSP_JWT_ALGORITHM=HS256
TSP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Необязательно: администратор создаётся при старте, если его ещё нет.
# TSP_ADMIN_EMAIL=admin@example.com
# TSP_ADMIN_PASSWORD=Admin12345
